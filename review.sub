# Review a PDF. Override the defaults below with -append (plain NAME=value arguments are NOT honoured):
#   condor_submit review.sub -append 'PDF=/path/to/paper.pdf' -append 'MODEL=llama3.2:3b' -append 'NUM_CTX=8192'
# The PDF must exist on the submit host; any path works.
# Use a bigger model for better reviews, e.g. MODEL=qwen2.5:32b with MIN_VRAM_MB=30000.
PDF         = paper.pdf
MODEL       = llama3.1:8b
MIN_VRAM_MB = 16000
NUM_CTX     = 32768

universe                = vanilla
executable              = bin/job.sh
arguments               = $(MODEL) python3 review_pdf.py $Fnx(PDF) --prompt review.txt --out review.md --num-ctx $(NUM_CTX)
transfer_input_files    = client/review_pdf.py, client/doc.py, client/oclient.py, prompts/review.txt, $(PDF)
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

request_gpus   = 1
request_cpus   = 4
request_memory = 32GB
request_disk   = 60GB
require_gpus   = (GlobalMemoryMb >= $(MIN_VRAM_MB))

output = logs/review.$(Cluster).out
error  = logs/review.$(Cluster).err
log    = logs/review.$(Cluster).log
queue
