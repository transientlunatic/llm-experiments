# Long-running server for interactive play: condor_submit serve.sub
# Then: condor_tail -stderr <jobid>  to see host:port, and ssh-tunnel to it.
MODEL       = llama3.1:8b
MIN_VRAM_MB = 16000

universe              = vanilla
executable            = bin/job.sh
arguments             = $(MODEL) serve
request_gpus          = 1
request_cpus          = 4
request_memory        = 32GB
request_disk          = 60GB
require_gpus          = (GlobalMemoryMb >= $(MIN_VRAM_MB))
+MaxRuntime           = 14400
periodic_remove       = (time() - JobCurrentStartDate) > 14400
should_transfer_files = YES
output = logs/serve.$(Cluster).out
error  = logs/serve.$(Cluster).err
log    = logs/serve.$(Cluster).log
queue
