# Batch job. Override defaults with -append (plain NAME=value arguments are NOT honoured):
#   condor_submit ollama.sub -append 'MODEL=llama3.2:1b' -append 'INPUT=prompts.jsonl'
MODEL       = llama3.1:8b
INPUT       = prompts.jsonl
MIN_VRAM_MB = 16000

universe                = vanilla
executable              = bin/job.sh
arguments               = $(MODEL) python3 generate.py $Fnx(INPUT) results.jsonl
transfer_input_files    = client/generate.py, $(INPUT)
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

request_gpus   = 1
request_cpus   = 4
request_memory = 32GB
request_disk   = 60GB
require_gpus   = (GlobalMemoryMb >= $(MIN_VRAM_MB))

output = logs/$(Cluster).$(Process).out
error  = logs/$(Cluster).$(Process).err
log    = logs/$(Cluster).log
queue
